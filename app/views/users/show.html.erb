<section class="user">
  <h1><%= @user.name %></h1>
  <h2><%= mail_to(@user.email) %>
  <% if current_user?(@user) %>
    <div class="actions">
      <%= link_to("Edit Account", edit_user_path(@user), class: "button edit") %>
      <%= link_to("Delete Account", @user,
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
        class: "button delete") %>
    </div>
  <% end %>
  <h3>Registrations</h3>
  <% if @registrations.present? %>
    <% @registrations.each do |r| %>
      <div class="registration" >
        <div class="image">
          <%= link_to(image_tag(r.event.image_file_name), r.event) %>
        </div>
        <div class="name">
          <%= link_to(r.event.name, r.event) %>
        </div>
        <div class="date">
          <%= time_ago_in_words(r.created_at) %> ago
        </div>
      </div>
    <% end %>
  <% end %>
</section>
